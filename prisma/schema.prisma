generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  name      String?
  email     String   @unique
  password  String
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========================
// Blog Module
// ========================

model BlogCategory {
  id             String   @id @default(uuid())
  name           String
  slug           String   @unique
  description    String?  @db.Text
  seoTitle       String?
  seoDescription String?  @db.Text
  status         String   @default("active") // "active" | "inactive"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  blogs Blog[]

  @@index([slug])
  @@index([status])
}

model BlogTag {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blogRelations BlogTagRelation[]

  @@index([slug])
}

model Blog {
  id               String        @id @default(uuid())
  title            String
  slug             String        @unique
  shortDescription String?       @db.Text
  content          String        @db.Text
  featuredImage    String?
  imageAltText     String?
  authorName       String?       @default("Admin")
  categoryId       String?
  category         BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  seoTitle         String?
  seoDescription   String?       @db.Text
  canonicalUrl     String?
  ogImage          String?
  status           String        @default("draft") // "draft" | "published" | "scheduled"
  isFeatured       Boolean       @default(false)
  publishedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  tags BlogTagRelation[]

  @@index([slug])
  @@index([status])
  @@index([isFeatured])
  @@index([publishedAt])
  @@index([categoryId])
}

model BlogTagRelation {
  blogId    String
  tagId     String
  blog      Blog    @relation(fields: [blogId], references: [id], onDelete: Cascade)
  tag       BlogTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([blogId, tagId])
  @@index([tagId])
  @@index([blogId])
}

// ========================
// Gallery Module
// ========================

model GalleryAlbum {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  description  String?  @db.Text
  coverImage   String?
  displayOrder Int      @default(0)
  status       String   @default("published") // "draft" | "published"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  images GalleryImage[]

  @@index([slug])
  @@index([status])
  @@index([displayOrder])
}

model GalleryImage {
  id           String        @id @default(uuid())
  title        String
  description  String?       @db.Text
  altText      String?
  imageUrl     String
  category     String?
  albumId      String?
  album        GalleryAlbum? @relation(fields: [albumId], references: [id], onDelete: SetNull)
  displayOrder Int           @default(0)
  status       String        @default("published") // "draft" | "published"
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([albumId])
  @@index([category])
  @@index([status])
  @@index([displayOrder])
}

// ========================
// Team Module
// ========================

model TeamDepartment {
  id           String   @id @default(uuid())
  name         String   @unique
  slug         String   @unique
  displayOrder Int      @default(0)
  status       String   @default("active") // "active" | "inactive"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members TeamMember[]

  @@index([slug])
  @@index([displayOrder])
}

model TeamMember {
  id           String          @id @default(uuid())
  fullName     String
  profilePhoto String?
  designation  String
  departmentId String?
  department   TeamDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  bio          String?         @db.Text
  email        String?
  phone        String?
  linkedinUrl  String?
  facebookUrl  String?
  instagramUrl String?
  displayOrder Int             @default(0)
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([departmentId])
  @@index([isActive])
  @@index([displayOrder])
}

// ========================
// Dynamic CMS Pages & Section Builder
// ========================

model CMSPage {
  id               String    @id @default(uuid())
  title            String
  slug             String    @unique
  shortDescription String?   @db.Text
  featuredImage    String?
  sections         Json      @default("[]") // Structured sections array
  seoTitle         String?
  seoDescription   String?   @db.Text
  canonicalUrl     String?
  ogImage          String?
  status           String    @default("draft") // "draft" | "published"
  publishedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([slug])
  @@index([status])
}

// ========================
// Menu Management
// ========================

model Menu {
  id          String     @id @default(uuid())
  name        String     @unique // e.g. "Header Menu", "Footer Menu"
  location    String     @unique // "header" | "footer" | "custom"
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  items MenuItem[]
}

model MenuItem {
  id           String     @id @default(uuid())
  menuId       String
  menu         Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parentId     String?
  parent       MenuItem?  @relation("MenuSubItems", fields: [parentId], references: [id], onDelete: Cascade)
  children     MenuItem[] @relation("MenuSubItems")
  label        String
  url          String
  target       String     @default("_self") // "_self" | "_blank"
  displayOrder Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([menuId])
  @@index([parentId])
  @@index([displayOrder])
}

// ========================
// Media Library
// ========================

model Media {
  id        String   @id @default(uuid())
  fileName  String
  fileUrl   String
  mimeType  String
  fileSize  Int      // Size in bytes
  altText   String?
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mimeType])
  @@index([createdAt])
}

// ========================
// Contact Enquiries
// ========================

model ContactEnquiry {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String   @db.Text
  status    String   @default("new") // "new" | "in_progress" | "resolved"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ========================
// Testimonials
// ========================

model Testimonial {
  id           String   @id @default(uuid())
  customerName String
  designation  String?
  company      String?
  profileImage String?
  content      String   @db.Text
  rating       Int      @default(5)
  displayOrder Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isPublished])
  @@index([displayOrder])
}

// ========================
// FAQs
// ========================

model FAQ {
  id           String   @id @default(uuid())
  question     String   @db.Text
  answer       String   @db.Text
  category     String?  @default("General")
  displayOrder Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
  @@index([isPublished])
  @@index([displayOrder])
}

// ========================
// Website Settings (Key-Value or Grouped)
// ========================

model SiteSetting {
  id        String   @id @default(uuid())
  group     String   // "general" | "header" | "footer" | "seo" | "social"
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group])
}

// ========================
// Activity Log
// ========================

model ActivityLog {
  id        String   @id @default(uuid())
  action    String   // e.g. "CREATE_BLOG", "UPDATE_SETTINGS"
  details   String?  @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
}


